    "rootDir": "src",
    "sourceMap": true,
    "noImplicitAny": true,
    "allowJs": true,
    "module": "es6",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "esModuleInterop": true,
    "strict": true,
    "declaration": true
  },
  "include": ["src"]
}
